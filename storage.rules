rules_version = '2';

// قواعد التخزين لمرفقات الحركات المالية (إيصالات، مستندات).
// القراءة للمستخدمين النشطين فقط (تحقق عبر Firestore) — أي حساب Google
// غير معتمد أو غير نشط لا يستطيع القراءة أو الحذف.
// الكتابة مقيّدة بالحجم والنوع، والحذف للمدير حصرًا.
service firebase.storage {
  match /b/{bucket}/o {

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    // تحقق أن المستدعي مستخدم نشط في قاعدة البيانات
    function isActiveUser() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && userDoc().isActive == true;
    }

    // تحقق أن المستدعي مدير نشط
    function isAdminUser() {
      return isActiveUser()
        && userDoc().role == 'admin';
    }

    // تحقق أن المستدعي يملك صلاحية عرض الحركات المالية أو مدير
    function canViewFinancials() {
      return isActiveUser()
        && (userDoc().role == 'admin'
            || (userDoc().financialPermissions != null && userDoc().financialPermissions.view == true));
    }

    match /attachments/{folderName}/{fileName} {
      // القراءة: لمن يملك صلاحية view أو المدير فقط — حماية للإيصالات والمستندات المالية
      allow read: if canViewFinancials();

      // الكتابة: المستخدم النشط (لإرفاق الإيصالات عند إنشاء العمليات) + قيود الحجم والنوع
      allow write: if isActiveUser()
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');

      // الحذف: المدير حصرًا — لا أي مستخدم نشط عادي
      allow delete: if isAdminUser();
    }
  }
}
