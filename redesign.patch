+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              Text(title, style: AppTypography.headlineLarge),
+              if (subtitle != null) ...[
+                const SizedBox(height: AppDimensions.spacing2),
+                Text(subtitle!, style: AppTypography.bodySmall),
